{
  "id": "/",
  "name": "Vladhost — хостинг сайтов",
  "short_name": "Vladhost",
  "description": "Панель хостинга Vladhost: сайты, файлы, домены, почта и базы данных.",
  "lang": "ru",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#070914",
  "theme_color": "#070914",
  "categories": ["productivity", "developer"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Сайты", "url": "/sites", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Почта", "url": "/mail", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Поддержка", "url": "/support", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
